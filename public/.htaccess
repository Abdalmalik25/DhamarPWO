# ============================================================
# Security and Performance Headers - مكتب الأشغال العامة والطرق
# النسخة المحسّنة - متوافقة مع أعلى معايير الأمان والأداء
# ============================================================

<IfModule mod_headers.c>
    # ============================================================
    # 1. رؤوس الأمان الأساسية - حماية ضد الهجمات الشائعة
    # ============================================================
    
    # منع هجمات MIME Sniffing
    Header set X-Content-Type-Options "nosniff" always
    
    # منع تضمين الموقع في إطارات (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN" always
    
    # حماية XSS (متصفحات قديمة)
    Header set X-XSS-Protection "1; mode=block" always
    
    # تحديد كيفية إرسال المعلومات المرجعية
    Header set Referrer-Policy "strict-origin-when-cross-origin" always
    
    # تقييد استخدام ميزات المتصفح (Permissions Policy)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), fullscreen=(self), accelerometer=(), gyroscope=(), magnetometer=()" always
    
    # ============================================================
    # 2. سياسة أمان المحتوى (CSP) - محدثة ومعززة
    # ============================================================
    # ملاحظة: يُوصى باختبار CSP في وضع التقرير أولاً (report-uri)
    # ثم تفعيل الحظر بعد التأكد من عدم تعطيل الوظائف.
    
    Header set Content-Security-Policy "
        default-src 'self';
        script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
        font-src 'self' https://fonts.gstatic.com data:;
        img-src 'self' data: https: blob:;
        connect-src 'self' https:;
        frame-src 'none';
        frame-ancestors 'none';
        base-uri 'self';
        form-action 'self';
        upgrade-insecure-requests;
        block-all-mixed-content;
        require-trusted-types-for 'script';
    " always
    
    # ============================================================
    # 3. رؤوس أمان إضافية (COOP, COEP) - عزل العمليات
    # ============================================================
    Header set Cross-Origin-Opener-Policy "same-origin" always
    Header set Cross-Origin-Embedder-Policy "require-corp" always
    Header set Cross-Origin-Resource-Policy "same-origin" always
    
    # ============================================================
    # 4. سياسة نقل البيانات - منع التنقل بين المواقع
    # ============================================================
    Header set X-Permitted-Cross-Domain-Policies "none" always
    
    # منع المتصفح من تخمين نوع المحتوى (إضافي للأمان)
    Header always set X-Content-Type-Options "nosniff"
    
    # ============================================================
    # 5. إزالة معلومات الخادم - منع كشف التفاصيل
    # ============================================================
    Header unset Server
    Header unset X-Powered-By
    Header unset X-AspNet-Version
    Header unset X-AspNetMvc-Version
    Header unset X-Generator
    
    # ============================================================
    # 6. HSTS - فرض الاتصال الآمن (HTTPS)
    # ============================================================
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always
    
    # ============================================================
    # 7. إدارة التخزين المؤقت - رؤوس Cache-Control محسّنة
    # ============================================================
    # الملفات الثابتة (CSS, JS, صور) - تخزين طويل الأمد
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|otf|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # ملفات HTML - تخزين قصير مع إعادة التحقق
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # ملفات JSON, XML, RSS - تخزين متوسط
    <FilesMatch "\.(json|xml|rss|atom)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
    
    # منع تخزين الملفات الحساسة (مثل .htaccess, .env)
    <FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak)$">
        Header set Cache-Control "private, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ============================================================
# 8. ضغط الملفات - Deflate + Brotli (إن وجد)
# ============================================================
<IfModule mod_deflate.c>
    # تمكين الضغط للملفات النصية
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml image/svg+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf
    AddOutputFilterByType DEFLATE font/opentype font/ttf font/otf

    # ضبط مستوى الضغط (1-9) - التوازن بين الأداء والحجم
    DeflateCompressionLevel 6

    # استثناء الملفات المضغوطة مسبقاً
    SetEnvIfNoCase Request_URI \.(?:gz|zip|bz2|rar|7z)$ no-gzip dont-vary
</IfModule>

# ============================================================
# 9. دعم Brotli (إذا كان متاحاً) - ضغط أسرع
# ============================================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI application/javascript application/x-javascript
    AddOutputFilterByType BROTLI application/json application/xml application/rss+xml
    AddOutputFilterByType BROTLI application/atom+xml image/svg+xml
    AddOutputFilterByType BROTLI application/vnd.ms-fontobject application/x-font-ttf
    AddOutputFilterByType BROTLI font/opentype font/ttf font/otf
</IfModule>

# ============================================================
# 10. التحكم في التخزين المؤقت عبر Expires
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # تعيين التواريخ الافتراضية
    ExpiresDefault "access plus 1 hour"
    
    # ملفات ثابتة - سنة واحدة
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    
    # HTML - ساعة واحدة
    ExpiresByType text/html "access plus 1 hour"
    
    # ملفات أخرى - يوم واحد
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ============================================================
# 11. إلغاء ETags لتحسين التخزين المؤقت
# ============================================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ============================================================
# 12. إعادة التوجيه لـ SPA (React/Vue) - دعم التوجيه الداخلي
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # إذا كان الملف أو الدليل موجوداً، لا تعيد التوجيه
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /index.html [L,QSA]
</IfModule>

# ============================================================
# 13. منع الوصول إلى الملفات الحساسة
# ============================================================
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================================
# 14. تعطيل قائمة الدليل
# ============================================================
Options -Indexes

# ============================================================
# 15. إعدادات إضافية لأداء أفضل
# ============================================================
# تمكين Keep-Alive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# تعيين الحد الأقصى لحجم التحميل (للملفات الكبيرة)
LimitRequestBody 52428800  # 50 MB

# منع تخزين الملفات المؤقتة للصفحات الديناميكية
<IfModule mod_headers.c>
    Header set Cache-Control "private, no-cache, no-store, must-revalidate" "env=NO_CACHE"
</IfModule>

# ============================================================
# 16. تعيين charset الافتراضي
# ============================================================
AddDefaultCharset UTF-8

# ============================================================
# 17. تعيين أنواع MIME الصحيحة (لمنع التنفيذ الخبيث)
# ============================================================
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg .svgz
AddType font/woff2 .woff2
AddType font/woff .woff
AddType application/manifest+json .webmanifest
AddType application/json .json
AddType application/xml .xml

# ============================================================
# 18. منع عرض محتوى الملفات النصية المصدرية (لملفات معينة)
# ============================================================
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff2|woff|ttf|eot)$">
    Header set Content-Disposition "inline"
</FilesMatch>

# ============================================================
# 19. إضافة دعم لـ CORS (إذا كان مطلوباً - اختياري)
# ============================================================
# Header set Access-Control-Allow-Origin "*"  # فقط إذا كنت بحاجة لـ API عام
# Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
# Header set Access-Control-Allow-Headers "Content-Type, Authorization"

# ============================================================
# 20. تقليل وقت استجابة الخادم (تحسين الأداء)
# ============================================================
<IfModule mod_env.c>
    SetEnv application_environment production
</IfModule>